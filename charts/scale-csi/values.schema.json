{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scale CSI chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "truenas",
    "zfs"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "fencing",
          "controller"
        ],
        "properties": {
          "fencing": {
            "properties": {
              "mode": {
                "enum": [
                  "additive",
                  "strict"
                ]
              }
            }
          },
          "controller": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "controller": {
            "properties": {
              "replicas": {
                "const": 1
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "freeObject": {
      "type": "object",
      "additionalProperties": true
    },
    "storageClassParameters": {
      "description": "StorageClass parameters. Arbitrary keys pass through verbatim, but the GF-Sprint 4 block-protocol knobs are validated here so an out-of-enum value is rejected at `helm install` instead of failing every CreateVolume at provision time. Values may be quoted strings (what Kubernetes stores) or bare YAML scalars.",
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "properties": {
        "iscsi/blocksize": {
          "description": "iSCSI extent logical blocksize. IMMUTABLE for the life of a volume.",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "512",
                "1024",
                "2048",
                "4096"
              ]
            },
            {
              "type": "integer",
              "enum": [
                512,
                1024,
                2048,
                4096
              ]
            }
          ]
        },
        "iscsi/pblocksize": {
          "$ref": "#/definitions/storageClassBoolParameter"
        },
        "iscsi/queuedCommands": {
          "description": "Per-target SCST queue depth (iscsi_parameters.QueuedCommands).",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "32",
                "128"
              ]
            },
            {
              "type": "integer",
              "enum": [
                32,
                128
              ]
            }
          ]
        },
        "iscsi/insecureTpc": {
          "$ref": "#/definitions/storageClassBoolParameter"
        },
        "iscsi/readOnly": {
          "$ref": "#/definitions/storageClassBoolParameter"
        },
        "iscsi/stableSerial": {
          "$ref": "#/definitions/storageClassBoolParameter"
        },
        "iscsi/availThreshold": {
          "description": "Per-extent early-full warning percentage, 1-99.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^([1-9]|[1-9][0-9])$"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          ]
        },
        "nvmeof/qidMax": {
          "description": "Maximum NVMe I/O queue count, 1-65535 (a queue identifier is 16-bit).",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,4}$"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          ]
        },
        "nvmeof/piEnable": {
          "$ref": "#/definitions/storageClassBoolParameter"
        },
        "nvmeof/inlineDataSize": {
          "description": "REJECTED as a per-StorageClass parameter: NVMe-oF port performance fields are install-wide (nvmeof.portPerf) because the port is shared across volumes.",
          "not": {}
        },
        "nvmeof/maxQueueSize": {
          "description": "REJECTED as a per-StorageClass parameter: NVMe-oF port performance fields are install-wide (nvmeof.portPerf) because the port is shared across volumes.",
          "not": {}
        },
        "nvmeof/portPiEnable": {
          "description": "REJECTED as a per-StorageClass parameter: NVMe-oF port performance fields are install-wide (nvmeof.portPerf) because the port is shared across volumes.",
          "not": {}
        }
      }
    },
    "storageClassBoolParameter": {
      "description": "A boolean StorageClass parameter. Kubernetes stores parameters as strings, so the quoted form is canonical; a bare YAML boolean is also accepted.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        {
          "type": "boolean"
        }
      ]
    },
    "kubernetesList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "string",
          "minLength": 2
        },
        "workerThreads": {
          "type": "integer",
          "minimum": 1
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "10m",
              "memory": "32Mi"
            },
            "limits": {
              "memory": "128Mi"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "storageClass": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "enum": [
            "nfs",
            "iscsi",
            "nvmeof"
          ]
        },
        "snapshotRestoreMode": {
          "type": "string",
          "enum": [
            "clone",
            "detached"
          ]
        },
        "isDefault": {
          "type": "boolean"
        },
        "reclaimPolicy": {
          "type": "string",
          "enum": [
            "Delete",
            "Retain"
          ]
        },
        "allowVolumeExpansion": {
          "type": "boolean"
        },
        "volumeBindingMode": {
          "type": "string",
          "enum": [
            "Immediate",
            "WaitForFirstConsumer"
          ]
        },
        "mountOptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraParameters": {
          "$ref": "#/definitions/storageClassParameters"
        },
        "chapSecretName": {
          "type": "string",
          "minLength": 1
        },
        "chapSecretNamespace": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "csiDriverName": {
      "type": "string",
      "minLength": 1
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "forImmediateBinding": {
          "type": "boolean"
        },
        "reportMaximumVolumeSize": {
          "type": "boolean"
        },
        "gaugeEnabled": {
          "type": "boolean"
        },
        "gaugeInterval": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h))+$",
          "not": {
            "pattern": "^(0+(ms|s|m|h))+$"
          }
        }
      }
    },
    "driverInstanceId": {
      "type": "string"
    },
    "fencing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "startupReconcileTimeout",
        "staleRecordGracePeriod"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "additive",
            "strict"
          ]
        },
        "startupReconcileTimeout": {
          "type": "string",
          "minLength": 2
        },
        "staleRecordGracePeriod": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "priorityClassName": {
          "type": "string"
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "not": {
            "allOf": [
              {
                "required": [
                  "minAvailable"
                ],
                "properties": {
                  "minAvailable": {
                    "not": {
                      "const": ""
                    }
                  }
                }
              },
              {
                "required": [
                  "maxUnavailable"
                ],
                "properties": {
                  "maxUnavailable": {
                    "not": {
                      "const": ""
                    }
                  }
                }
              }
            ]
          }
        },
        "containerSecurityContext": {
          "$ref": "#/definitions/freeObject"
        },
        "resources": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "10m",
              "memory": "32Mi"
            },
            "limits": {
              "memory": "256Mi"
            }
          },
          "additionalProperties": true
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/kubernetesList"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        },
        "extraEnv": {
          "$ref": "#/definitions/kubernetesList"
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/kubernetesList"
        },
        "extraVolumes": {
          "$ref": "#/definitions/kubernetesList"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "priorityClassName": {
          "type": "string"
        },
        "sessionCleanupDelay": {
          "type": "integer",
          "minimum": 0
        },
        "maxVolumesPerNode": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "10m",
              "memory": "32Mi"
            },
            "limits": {
              "memory": "256Mi"
            }
          },
          "additionalProperties": true
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/kubernetesList"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        },
        "extraEnv": {
          "$ref": "#/definitions/kubernetesList"
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/kubernetesList"
        },
        "extraVolumes": {
          "$ref": "#/definitions/kubernetesList"
        }
      }
    },
    "kubeletDir": {
      "type": "string",
      "minLength": 1
    },
    "truenas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "secure": {
          "type": "boolean"
        },
        "skipTLSVerify": {
          "type": "boolean"
        },
        "caCert": {
          "type": "string"
        },
        "caCertFile": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "requestTimeout": {
          "type": "integer",
          "minimum": 1
        },
        "connectTimeout": {
          "type": "integer",
          "minimum": 1
        },
        "writeTimeout": {
          "type": "integer",
          "minimum": 1
        },
        "maxConcurrentRequests": {
          "type": "integer",
          "minimum": 1
        },
        "maxConnections": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 16
        }
      },
      "not": {
        "allOf": [
          {
            "properties": {
              "apiKey": {
                "minLength": 1
              }
            },
            "required": [
              "apiKey"
            ]
          },
          {
            "properties": {
              "existingSecret": {
                "minLength": 1
              }
            },
            "required": [
              "existingSecret"
            ]
          }
        ]
      }
    },
    "zfs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentDataset"
      ],
      "properties": {
        "parentDataset": {
          "type": "string"
        },
        "datasetProperties": {
          "$ref": "#/definitions/stringMap"
        },
        "zvolBlocksize": {
          "type": "string",
          "minLength": 1
        },
        "zvolEnableReservation": {
          "type": "boolean"
        },
        "enforceQuota": {
          "type": "boolean"
        },
        "detachedVolumesFromSnapshots": {
          "type": "boolean",
          "default": false
        },
        "zvolReadyTimeout": {
          "type": "integer",
          "minimum": 1
        },
        "destroyForeignSnapshotsOnDelete": {
          "type": "boolean"
        },
        "holdCsiSnapshots": {
          "type": "boolean",
          "default": false
        },
        "snapshotSchedule": {
          "type": "string",
          "default": ""
        },
        "snapshotRetention": {
          "type": "string",
          "default": ""
        },
        "promoteRestoredClones": {
          "type": "boolean",
          "default": false
        },
        "reportVolumeUsage": {
          "type": "boolean",
          "default": false
        },
        "dedup": {
          "type": "boolean",
          "description": "Deprecated compatibility value; use datasetProperties."
        },
        "compression": {
          "type": "boolean",
          "description": "Deprecated compatibility value; use datasetProperties."
        },
        "compressionAlgorithm": {
          "type": "string",
          "description": "Deprecated compatibility value; use datasetProperties."
        }
      }
    },
    "nfs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "server": {
          "type": "string"
        },
        "shareAllowedNetworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shareMaprootUser": {
          "type": "string"
        },
        "shareMaprootGroup": {
          "type": "string"
        },
        "shareMapallUser": {
          "type": "string"
        },
        "shareMapallGroup": {
          "type": "string"
        }
      }
    },
    "iscsi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "portal": {
          "type": "string"
        },
        "portalPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "extentBlocksize": {
          "type": "integer",
          "minimum": 1
        },
        "extentDisablePhysicalBlocksize": {
          "type": "boolean"
        },
        "extentRpm": {
          "type": [
            "string",
            "integer"
          ]
        },
        "extentAvailThreshold": {
          "description": "DEPRECATED, ignored. Retained only so old values files pass validation.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "deviceWaitTimeout": {
          "type": "integer",
          "minimum": 1
        },
        "serviceReloadDebounce": {
          "type": "integer",
          "minimum": 0
        },
        "chap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tag": {
              "type": "integer",
              "minimum": 0
            },
            "mutual": {
              "type": "boolean"
            }
          }
        },
        "targetGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "portal": {
                "type": "integer"
              },
              "initiator": {
                "type": "integer"
              },
              "authMethod": {
                "type": "string"
              },
              "auth": {
                "type": "integer"
              }
            },
            "required": [
              "portal",
              "initiator"
            ]
          }
        }
      }
    },
    "nvmeof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "transport": {
          "type": "string",
          "enum": [
            "tcp",
            "rdma"
          ]
        },
        "address": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "subsystemHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subsystemAllowAnyHost": {
          "type": "boolean"
        },
        "portPerf": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inlineDataSize": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "maxQueueSize": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "piEnable": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "multipath": {
          "type": "boolean"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commandTimeout": {
          "description": "DEPRECATED, ignored; the nvme CLI timeout is commandTimeouts.nvme. Retained only so old values files pass validation.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "storageClasses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/storageClass"
      }
    },
    "storageClass": {
      "$ref": "#/definitions/storageClass"
    },
    "snapshotClass": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "deletionPolicy": {
          "type": "string",
          "enum": [
            "Delete",
            "Retain"
          ]
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "sidecars": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaderElection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "leaseDuration": {
              "type": "string",
              "minLength": 2
            },
            "renewDeadline": {
              "type": "string",
              "minLength": 2
            },
            "retryPeriod": {
              "type": "string",
              "minLength": 2
            }
          }
        },
        "provisioner": {
          "$ref": "#/definitions/sidecar"
        },
        "attacher": {
          "$ref": "#/definitions/sidecar"
        },
        "resizer": {
          "$ref": "#/definitions/sidecar"
        },
        "snapshotter": {
          "$ref": "#/definitions/sidecar"
        },
        "nodeDriverRegistrar": {
          "$ref": "#/definitions/sidecar"
        },
        "livenessProbe": {
          "$ref": "#/definitions/sidecar"
        },
        "healthMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "interval": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h))+$",
              "not": {
                "pattern": "^(0+(ms|s|m|h))+$"
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "controllerName": {
          "type": "string"
        },
        "nodeName": {
          "type": "string"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "podSecurityContext": {
      "$ref": "#/definitions/freeObject"
    },
    "securityContext": {
      "$ref": "#/definitions/freeObject"
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verbosity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "interval": {
              "type": "string",
              "minLength": 2
            },
            "scrapeTimeout": {
              "type": "string",
              "minLength": 2
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
