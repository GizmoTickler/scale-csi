    "nfs": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "title": "KRB5 share security is coupled to krbEnabled",
          "description": "KRB5/KRB5I/KRB5P require Kerberos on the TrueNAS NFS service (nfs.config v4_krb plus a keytab). Without nfs.krbEnabled=true the only selectable mode is SYS: a krb-only export on a box with no KDC or keytab makes every mount fail, and nfs.shareSecurity is stamped on EVERY newly created export. The driver enforces the same rule at config load, because a hand-written ConfigMap bypasses this schema.",
          "if": {
            "properties": {
              "krbEnabled": {
                "const": true
              }
            },
            "required": [
              "krbEnabled"
            ]
          },
          "then": true,
          "else": {
            "properties": {
              "shareSecurity": {
                "items": {
                  "enum": [
                    "SYS"
                  ]
                }
              }
            }
          }
        },
        {
          "title": "maproot_* and mapall_* are mutually exclusive",
          "description": "TrueNAS rejects a sharing.nfs.create payload that carries both squash mappings. Setting nfs.shareMapallUser/Group requires clearing nfs.shareMaprootUser/Group. Scoped to nfs.enabled, mirroring the driver: with NFS disabled these keys build no payload at all, and an install that was inert on 1.4.1 must not fail a 1.5.0 upgrade over them.",
          "if": {
            "allOf": [
              {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              {
                "anyOf": [
                  {
                    "properties": {
                      "shareMapallUser": {
                        "minLength": 1
                      }
                    },
                    "required": [
                      "shareMapallUser"
                    ]
                  },
                  {
                    "properties": {
                      "shareMapallGroup": {
                        "minLength": 1
                      }
                    },
                    "required": [
                      "shareMapallGroup"
                    ]
                  }
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "shareMaprootUser": {
                "maxLength": 0
              },
              "shareMaprootGroup": {
                "maxLength": 0
              }
            }
          }
        }
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "server": {
          "type": "string"
        },
        "shareAllowedNetworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shareMaprootUser": {
          "type": "string"
        },
        "shareMaprootGroup": {
          "type": "string"
        },
        "shareMapallUser": {
          "type": "string"
        },
        "shareMapallGroup": {
          "type": "string"
        },
        "shareSecurity": {
          "description": "Default sharing.nfs security list. Empty (default) omits the field, keeping the TrueNAS default (AUTH_SYS).",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "SYS",
              "KRB5",
              "KRB5I",
              "KRB5P"
            ]
          }
        },
        "shareExposeSnapshots": {
          "description": "Publish the dataset's read-only .zfs/snapshot tree through new exports.",
          "type": "boolean"
        },
        "krbEnabled": {
          "description": "Acknowledge that nfs.config v4_krb plus a keytab are configured. Required before KRB5* share security is accepted.",
          "type": "boolean"
        },
        "versionPreflight": {
          "description": "Validate a StorageClass's pinned NFS version against the global nfs.config protocols.",
          "type": "boolean"
        },
        "ensureProtocols": {
          "description": "HARD RULE, opt-in: mutate the GLOBAL TrueNAS NFS service so these major versions are enabled. Affects every export on the appliance.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "NFSV3",
              "NFSV4"
            ]
          }
        }
      }
    },
