      }
    },
    {
      "name": "a reconnecting controller that never had a path device is reported, not waited for",
      "policy": "auto",
      "transport": "tcp",
      "mdts": 0,
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
          "heads": {"nvme0n1": 32768},
          "controllers": [
            {"name": "nvme0", "state": "live", "transport": "tcp", "paths": {"nvme0c0n1": 32768}},
            {"name": "nvme1", "state": "connecting", "transport": "tcp", "paths": {}},
            {"name": "nvme2", "state": "connecting", "transport": "tcp", "paths": {"nvme0c2n1": 32768}}
          ]
        }
      ],
      "expect": {
        "error": false,
        "mdtsQueried": true,
        "limitKB": 4096,
        "skipped": false,
        "waiting": ["nvme1"],
        "after": {"nvme0n1": 4096, "nvme0c0n1": 4096, "nvme0c2n1": 4096}
      }
    },
    {
      "name": "nvme_core.multipath=N: two subsystem directories, one namespace device per controller",
      "policy": "auto",
      "transport": "tcp",
      "mdts": 0,
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
