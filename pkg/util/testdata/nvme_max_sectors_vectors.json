    },
    {
      "name": "a subsystem missing from sysfs fails the clamp",
      "policy": "auto",
      "transport": "tcp",
      "mdts": 0,
      "nqn": "nqn.test:absent",
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
          "heads": {"nvme0n1": 32768},
          "controllers": [
            {"name": "nvme0", "state": "live", "transport": "tcp", "paths": {"nvme0c0n1": 32768}}
          ]
        }
      ],
      "expect": {
        "error": true,
        "mdtsQueried": false,
        "limitKB": 0,
        "skipped": false,
        "after": {"nvme0n1": 32768, "nvme0c0n1": 32768}
      }
    },
    {
      "name": "a live controller without its path device fails the clamp",
      "policy": "auto",
      "transport": "tcp",
      "mdts": 0,
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
          "heads": {"nvme0n1": 32768},
          "controllers": [
            {"name": "nvme0", "state": "live", "transport": "tcp", "paths": {"nvme0c0n1": 32768}},
            {"name": "nvme1", "state": "live", "transport": "tcp", "paths": {}}
          ]
        }
      ],
      "expect": {
        "error": true,
