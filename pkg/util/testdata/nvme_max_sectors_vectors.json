      "expect": {
        "error": false,
        "mdtsQueried": false,
        "limitKB": 4096,
        "skipped": false,
        "after": {"nvme0n1": 4096, "nvme0c0n1": 512}
      }
    },
    {
      "name": "auto leaves an RDMA subsystem alone",
      "policy": "auto",
      "transport": "rdma",
      "mdts": 0,
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
          "heads": {"nvme0n1": 32768},
          "controllers": [
            {"name": "nvme0", "state": "live", "transport": "rdma", "paths": {"nvme0c0n1": 32768}}
          ]
        }
      ],
      "expect": {
        "error": false,
        "mdtsQueried": false,
        "limitKB": 0,
        "skipped": true,
        "after": {"nvme0n1": 32768, "nvme0c0n1": 32768}
      }
    },
    {
      "name": "fixed value lowers whatever the transport and MDTS, never raises",
      "policy": "2048",
      "transport": "rdma",
      "mdts": 11,
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
          "heads": {"nvme0n1": 32768},
          "controllers": [
            {"name": "nvme0", "state": "live", "transport": "rdma", "paths": {"nvme0c0n1": 1024}},
            {"name": "nvme1", "state": "live", "transport": "rdma", "paths": {"nvme0c1n1": 32768}}
          ]
        }
      ],
      "expect": {
        "error": false,
        "mdtsQueried": false,
        "limitKB": 2048,
        "skipped": false,
        "after": {"nvme0n1": 2048, "nvme0c0n1": 1024, "nvme0c1n1": 2048}
      }
    },
    {
      "name": "fixed value above the current one changes nothing",
      "policy": "65536",
      "transport": "tcp",
      "mdts": 0,
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
          "heads": {"nvme0n1": 32768},
          "controllers": [
            {"name": "nvme0", "state": "live", "transport": "tcp", "paths": {"nvme0c0n1": 32768}}
          ]
        }
      ],
      "expect": {
        "error": false,
        "mdtsQueried": false,
        "limitKB": 65536,
        "skipped": false,
        "after": {"nvme0n1": 32768, "nvme0c0n1": 32768}
      }
    },
    {
      "name": "off touches nothing",
      "policy": "off",
      "transport": "tcp",
      "mdts": 0,
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
          "heads": {"nvme0n1": 32768},
          "controllers": [
            {"name": "nvme0", "state": "live", "transport": "tcp", "paths": {"nvme0c0n1": 32768}}
          ]
        }
      ],
      "expect": {
        "error": false,
        "mdtsQueried": false,
        "limitKB": 0,
        "skipped": true,
        "after": {"nvme0n1": 32768, "nvme0c0n1": 32768}
      }
    },
    {
      "name": "0 is off",
      "policy": "0",
      "transport": "tcp",
      "mdts": 0,
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
          "heads": {"nvme0n1": 32768},
          "controllers": [
            {"name": "nvme0", "state": "live", "transport": "tcp", "paths": {"nvme0c0n1": 32768}}
          ]
        }
      ],
      "expect": {
        "error": false,
        "mdtsQueried": false,
        "limitKB": 0,
        "skipped": true,
        "after": {"nvme0n1": 32768, "nvme0c0n1": 32768}
      }
    },
    {
      "name": "a device that cannot be written fails the clamp",
      "policy": "auto",
      "transport": "tcp",
      "mdts": 0,
      "subsystems": [
        {
          "name": "nvme-subsys0",
          "nqn": "nqn.test:vol",
          "heads": {"nvme0n1": 32768},
          "controllers": [
            {"name": "nvme0", "state": "live", "transport": "tcp", "paths": {"nvme0c0n1": 32768}},
            {"name": "nvme1", "state": "live", "transport": "tcp", "paths": {"nvme0c1n1": 32768}}
          ]
        }
      ],
      "unwritable": ["nvme0c1n1"],
      "expect": {
        "error": true,
        "mdtsQueried": true,
        "limitKB": 4096,
        "skipped": false,
        "after": {"nvme0n1": 4096, "nvme0c0n1": 4096, "nvme0c1n1": -1}
